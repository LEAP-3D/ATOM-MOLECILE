// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id // Clerk-ийн user_id-г энд хадгална (жишээ нь: user_2...)
  email     String   @unique
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Хэрэглэгчийн оруулсан файлуудтай холбох (1-to-many)
  files UploadedFile[]

  @@map("users")
}

model UploadedFile {
  id         BigInt   @id @default(autoincrement())
  fileName   String   @map("file_name")
  content    Json
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  // User-тэй холбох хэсэг
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  @@map("uploaded_files")
}

enum ChartType {
  bar
  pie
  line
  area
  scatter
  bar_rice
}

model ChartHistory {
  id String @id @default(cuid())

  // Auth / ownership (Clerk user id гэх мэт)
  userId String

  // File context
  fileId   String? // optional: uploaded_files table-тай холбох бол
  fileName String

  // Query layer
  originalQuery   String
  normalizedQuery String
  sql             String

  // Chart layer
  chartType   ChartType
  title       String
  description String?
  xAxisKey    String
  yAxisKey    String

  // Result snapshot (render хийхэд хангалттай)
  data        Json // [{ class: "English", student_count: 60 }, ...]
  insight     Json? // { summary: "...", bullets: [...] } гэх мэт

  // Meta
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, fileName])
  @@map("chart_history")
}
